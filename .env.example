# Copy this file to .env and fill in only what you actually have.
# The app runs completely fine with none of these set -- SQLite + deterministic
# fallback rules are the defaults. Never commit a real .env file.

# --- App ---
ENVIRONMENT=local

# --- Database ---
# Local default (no setup required):
DATABASE_URL=sqlite:///./razorrecover.db
# Production example:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/razorrecover

# --- AI provider ---
# "none" uses the deterministic fallback_provider -- zero API keys needed to demo.
AI_PROVIDER=none
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_TIMEOUT_SECONDS=8.0

# --- Razorpay Test Mode (optional) ---
# Leave blank to run entirely on the local payment simulator.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
USE_RAZORPAY_TEST_MODE=false

# --- Policy engine bounds ---
MAX_RECOVERY_ATTEMPTS=3
LOW_CONFIDENCE_THRESHOLD=0.55
HIGH_VALUE_ESCALATION_THRESHOLD=1500000

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173"]
